# Server Configuration
PORT=4000
NODE_ENV=production

# SQLite Database (file-based, no external DB needed)
# Optional: Set custom path for the SQLite database file
# SQLITE_DB_PATH=/path/to/biltronix.db

# CORS Configuration
API_CORS_ORIGINS=https://your-frontend.onrender.com,https://your-domain.com

# Admin Credentials (Change these!)
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=your-secure-password-here

# JWT Configuration (Required - generate a secure random secret)
JWT_SECRET=generate-a-secure-random-secret-here-min-32-chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Email Configuration (Optional - for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_SECURE=false
SMTP_FROM=your-email@gmail.com