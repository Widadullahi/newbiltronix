# Server Configuration
PORT=4000
NODE_ENV=production

# Database Configuration (Update with your Render MySQL credentials)
DB_HOST=localhost
DB_PORT=3306
DB_USER=biltronix_user
DB_PASSWORD=your_database_password
DB_NAME=biltronix_db

# CORS Configuration
API_CORS_ORIGINS=https://your-frontend-url.onrender.com,https://your-domain.com

# Admin Credentials (Change these!)
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=your-secure-password-here

# JWT Configuration
JWT_SECRET=generate-a-secure-random-secret-here-min-32-chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Email Configuration (Optional - for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_SECURE=false
SMTP_FROM=your-email@gmail.com